FROM debian-base:latest

RUN mkdir -p /usr/local/bin /app/data

COPY bin/mcp-agent-mail /usr/local/bin/mcp-agent-mail
COPY bin/am /usr/local/bin/am
RUN chmod +x /usr/local/bin/mcp-agent-mail /usr/local/bin/am

EXPOSE 8765

WORKDIR /app

ENTRYPOINT ["am", "serve-http", "--host", "0.0.0.0", "--port", "8765", "--path", "api", "--no-auth"]